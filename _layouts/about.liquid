---
layout: default
---
<article class="portfolio">
  <section class="portfolio-hero" id="about" aria-labelledby="about-heading">
    <div class="portfolio-bio">
      <p class="portfolio-eyebrow">{{ page.eyebrow | escape }}</p>
      <h1 id="about-heading">
        {{ site.first_name | escape }}
        {% if site.middle_name -%}
          <span>{{ site.middle_name | escape }}</span>
        {%- endif %}
        {{ site.last_name | escape }}
      </h1>
      <div class="portfolio-intro">{{ content }}</div>
      <div class="portfolio-social" aria-label="Contact and profiles">
        <a href="mailto:{{ site.email }}"><i class="fa-regular fa-envelope" aria-hidden="true"></i> Email</a>
        {% if site.scholar_userid -%}
          <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Scholar <span aria-hidden="true">↗</span></a>
        {%- endif %}
        {% if site.github_username -%}
          <a href="https://github.com/{{ site.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
        {%- endif %}
        {% if site.linkedin_username -%}
          <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}">LinkedIn <span aria-hidden="true">↗</span></a>
        {%- endif %}
      </div>
    </div>
    <figure class="portfolio-portrait">
      <div class="portfolio-portrait-frame">
        <img
          src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
          alt="{{ page.profile.alt | escape }}"
          width="400"
          height="400"
          fetchpriority="high"
        >
      </div>
      <figcaption>{{ page.profile.caption | escape }}</figcaption>
    </figure>
  </section>

  {% if site.data.affiliations.size > 0 %}
    <div class="portfolio-affiliations" aria-label="Affiliations">
      {% for affiliation in site.data.affiliations %}
        <a href="{{ affiliation.url | escape }}">
          <img
            {% if affiliation.wide %}
              class="portfolio-logo-wide"
            {% endif %}
            src="{{ affiliation.logo | relative_url }}"
            alt="{{ affiliation.name | escape }}"
            height="{{ affiliation.height | default: 29 }}"
          >
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {% if page.news and site.announcements.enabled %}
    <section
      class="portfolio-section portfolio-news"
      id="about-news"
      aria-labelledby="news-heading"
      data-reveal
      data-expandable="news"
      data-preview-limit="{{ site.announcements.limit }}"
    >
      <div class="portfolio-section-heading">
        <h2 id="news-heading">Latest news</h2>
        <button class="portfolio-more portfolio-expand" type="button" aria-expanded="false" aria-controls="all-news" data-label="All news" hidden>
          All news <span aria-hidden="true">↓</span>
        </button>
      </div>
      <div id="all-news" class="portfolio-list">{% include news.liquid %}</div>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="portfolio-section portfolio-research" id="about-publications" aria-labelledby="research-heading" data-expandable="publications">
      <div class="portfolio-section-heading" data-reveal>
        <h2 id="research-heading">Selected research</h2>
        <button
          class="portfolio-more portfolio-expand"
          type="button"
          aria-expanded="false"
          aria-controls="all-publications"
          data-label="All publications"
          hidden
        >
          All publications <span aria-hidden="true">↓</span>
        </button>
      </div>
      <div id="all-publications" class="publications portfolio-list">{% bibliography --group_by none %}</div>
    </section>
  {% endif %}

  {% if page.projects %}
    <section class="portfolio-section" id="about-projects" aria-labelledby="projects-heading" data-expandable="projects">
      <div class="portfolio-section-heading" data-reveal>
        <h2 id="projects-heading">Selected projects</h2>
        <button
          class="portfolio-more portfolio-expand"
          type="button"
          aria-expanded="false"
          aria-controls="all-projects"
          data-label="All projects"
          hidden
        >
          All projects <span aria-hidden="true">↓</span>
        </button>
      </div>
      <div id="all-projects" class="portfolio-list">{% include portfolio-projects.liquid %}</div>
    </section>
  {% endif %}

  <section class="portfolio-contact" id="contact" aria-labelledby="contact-heading" data-reveal>
    <div>
      <p class="portfolio-eyebrow">{{ page.contact.eyebrow | escape }}</p>
      <h2 id="contact-heading">{{ page.contact.heading | escape }}</h2>
      <p>{{ page.contact.description | escape }}</p>
    </div>
    <div class="portfolio-contact-links">
      <a class="portfolio-contact-button" href="mailto:{{ site.email }}">Get in touch <span aria-hidden="true">↗</span></a>
      {% if page.contact.topics_url %}
        <a href="{{ page.contact.topics_url | escape }}">Open research topics <span aria-hidden="true">↗</span></a>
      {% endif %}
    </div>
  </section>
</article>
