<div class="portfolio-project-grid">
  {% assign sorted_projects = site.projects | sort: 'importance' %}
  {% for project in sorted_projects %}
    {% if project.redirect %}
      {% assign project_url = project.redirect %}
    {% else %}
      {% assign project_url = project.url | relative_url %}
    {% endif %}
    <article class="portfolio-project" data-reveal data-portfolio-selected="{{ project.selected | default: false }}">
      <div class="portfolio-project-media">
        {% if project.video %}
          <video
            src="{{ project.video | relative_url }}"
            preload="metadata"
            loop
            muted
            playsinline
            controls
            aria-label="{{ project.title | escape }} demo"
          ></video>
        {% elsif project.img %}
          <a href="{{ project_url }}" tabindex="-1" aria-hidden="true">
            <img src="{{ project.img | relative_url }}" alt="" loading="lazy" width="480" height="300">
          </a>
        {% endif %}
      </div>
      <div class="portfolio-project-content">
        <h3>
          <a href="{{ project_url }}">
            {{- project.title }}
            <span aria-hidden="true">↗</span></a
          >
        </h3>
        <p>{{ project.description }}</p>
        {% if project.github %}
          {% if project.github contains '://' %}
            {% assign github_url = project.github %}
          {% else %}
            {% assign github_url = project.github | prepend: 'https://github.com/' %}
          {% endif %}
          <a class="portfolio-project-code" href="{{ github_url }}"><i class="fa-brands fa-github" aria-hidden="true"></i> Code</a>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</div>
