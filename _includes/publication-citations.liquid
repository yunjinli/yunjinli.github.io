{% if site.enable_publication_badges.google_scholar %}
  {% assign citation = entry | scholar_citation %}
  <a
    class="publication-citations btn btn-sm z-depth-0"
    href="{{ citation.url | escape }}"
    {% if citation.citations != null %}
      title="Google Scholar citations{% if citation.checked_at %} · Checked {{ citation.checked_at | date: '%b %d, %Y' }}{% endif %}"
      aria-label="{{ citation.citations }} Google Scholar citations for {{ entry.title | escape }}"
    {% else %}
      title="View this publication on Google Scholar"
    {% endif %}
  >
    <i class="ai ai-google-scholar" aria-hidden="true"></i>
    {% if citation.citations != null -%}
      Cited by {{ citation.citations -}}
    {%- else -%}
      Google Scholar <span aria-hidden="true">↗</span>
    {%- endif %}
  </a>
{% endif %}
